ErlangTypeMap ::= [
    "boolean":"boolean()",
    "int":"integer()",
    "float":"float()",
    "String":"binary()",
    default : key
]

fileHeader(grammarFileName, ANTLRVersion) ::= <<
%% Code generated from <grammarFileName> by ANTLR <ANTLRVersion>. DO NOT EDIT.
>>

ParserFile(file, parser, namedActions, contextSuperClass) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

-module(<file.grammarName; format="lower">_parser).

-export([new/1]).

-include_lib("antlr4/include/antlr4_runtime.hrl").
<if(namedActions.header)>

<namedActions.header>
<endif>

<if(parser)>

<parser>
<endif>
>>

ListenerFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

-module(<file.grammarName; format="lower">_listener).

%% Listener behavior for <file.grammarName>

-export([behaviour_info/1]).

behaviour_info(callbacks) ->
    [
        {enter_every_rule, 1},
        {exit_every_rule, 1},
        {visit_terminal, 1},
        {visit_error_node, 1}<if(file.listenerNames)>,
        <file.listenerNames:{lname | {enter_<lname; format="lower">, 1\},
        {exit_<lname; format="lower">, 1\}}; separator=",\n        "><endif>
    ];
behaviour_info(_Other) ->
    undefined.
>>

BaseListenerFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

-module(<file.grammarName; format="lower">_base_listener).

-behaviour(<file.grammarName; format="lower">_listener).

-export([
    enter_every_rule/1,
    exit_every_rule/1,
    visit_terminal/1,
    visit_error_node/1<if(file.listenerNames)>,
    <file.listenerNames:{lname | enter_<lname; format="lower">/1,
    exit_<lname; format="lower">/1}; separator=",\n    "><endif>
]).

enter_every_rule(_Ctx) -> ok.
exit_every_rule(_Ctx) -> ok.
visit_terminal(_Node) -> ok.
visit_error_node(_Node) -> ok.

<file.listenerNames:{lname |
enter_<lname; format="lower">(_Ctx) -> ok.
exit_<lname; format="lower">(_Ctx) -> ok.
}; separator="\n">
>>

VisitorFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

-module(<file.grammarName; format="lower">_visitor).

%% Visitor behavior for <file.grammarName>

-export([behaviour_info/1]).

behaviour_info(callbacks) ->
    [
        {visit, 1},
        {visit_children, 1}<if(file.visitorNames)>,
        <file.visitorNames:{lname | {visit_<lname; format="lower">, 1\}}; separator=",\n        "><endif>
    ];
behaviour_info(_Other) ->
    undefined.
>>

BaseVisitorFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

-module(<file.grammarName; format="lower">_base_visitor).

-behaviour(<file.grammarName; format="lower">_visitor).

-export([
    visit/1,
    visit_children/1<if(file.visitorNames)>,
    <file.visitorNames:{lname | visit_<lname; format="lower">/1}; separator=",\n    "><endif>
]).

visit(Tree) ->
    antlr4_parse_tree:accept(Tree, ?MODULE).

visit_children(Ctx) ->
    antlr4_parse_tree:visit_children(Ctx, ?MODULE).

<file.visitorNames:{lname |
visit_<lname; format="lower">(Ctx) ->
    visit_children(Ctx).
}; separator="\n">
>>

Parser(parser, funcs, atn, sempredFuncs, superClass) ::= <<
%% Token type constants
-define(<parser.name; format="upper">_EOF, -1).
<if(parser.tokens)>
<parser.tokens:{k | -define(<parser.name; format="upper">_<k>, <parser.tokens.(k)>).}; separator="\n">
<endif>

%% Rule index constants
<if(parser.rules)>
<parser.rules:{r | -define(<parser.name; format="upper">_RULE_<r.name>, <r.index>).}; separator="\n">
<endif>

%% Rule names
-define(RULE_NAMES, [<parser.ruleNames:{r | "<r>"}; separator=", ">]).

%% Literal names
-define(LITERAL_NAMES, [<parser.literalNames; null="undefined", separator=", ">]).

%% Symbolic names
-define(SYMBOLIC_NAMES, [<parser.symbolicNames; null="undefined", separator=", ">]).

%% Serialized ATN
-define(SERIALIZED_ATN, <atn>).

%% Create a new parser state (stored in ETS)
new(Input) ->
    ATN = antlr4_atn_deserializer:deserialize(?SERIALIZED_ATN),
    DecisionToDFA = antlr4_atn:create_decision_to_dfa(ATN),
    SharedContextCache = antlr4_prediction_context:new_cache(),
    antlr4_parser:init(#{
        input => Input,
        error_handler => antlr4_default_error_strategy,
        atn => ATN,
        decision_to_dfa => DecisionToDFA,
        shared_context_cache => SharedContextCache,
        build_parse_trees => true,
        ctx => undefined,
        state_number => -1,
        error_listeners => [antlr4_error_listener],
        parse_listeners => [],
        exception => undefined,
        rule_names => ?RULE_NAMES
    }),
    ok.

<if(funcs)>

<funcs; separator="\n\n">
<endif>

<if(sempredFuncs)>

sempred(LocalCtx, RuleIndex, PredIndex) ->
    case RuleIndex of
        <parser.sempredFuncs.values:{f | ?<parser.name; format="upper">_RULE_<f.name> ->
            '<f.escapedName>_sempred'(LocalCtx, PredIndex)}; separator=";\n        ">
    end.

<sempredFuncs.values; separator="\n\n">
<endif>
>>

RuleFunction(currentRule, args, code, locals, ruleCtx, altLabelCtxs, namedActions, finallyAction, postamble, exceptions) ::= <<
-export(['<currentRule.escapedName>'/1]).

%% Rule: <currentRule.name>
'<currentRule.escapedName>'(State0) ->
    antlr4_parser:init(State0),
    '<currentRule.escapedName>'().

'<currentRule.escapedName>'() ->
    LocalCtx = antlr4_parser:enter_rule(?<parser.name; format="upper">_RULE_<currentRule.name>),
    <if(namedActions.init)>
    <namedActions.init>,
    <endif>
    try
        <code>
        <if(postamble)>,
        <postamble; separator=",\n        ">
        <endif>
    catch
        throw:Reason ->
            antlr4_parser:handle_rule_exception(Reason);
        error:Reason:Stacktrace ->
            antlr4_parser:handle_rule_exception({error, Reason, Stacktrace})
    <if(finallyAction)>
    after
        <finallyAction>
    <endif>
    end,
    antlr4_parser:exit_rule(),
    antlr4_parser:get_state().
>>

LeftRecursiveRuleFunction(currentRule, args, code, locals, ruleCtx, altLabelCtxs, namedActions, finallyAction, postamble) ::= <<
%% Left-recursive rule: <currentRule.name>
'<currentRule.escapedName>'(State0) ->
    antlr4_parser:init(State0),
    '<currentRule.escapedName>'(0).

'<currentRule.escapedName>'(Precedence) ->
    _ParentCtx = antlr4_parser:get_ctx(),
    _ParentState = antlr4_parser:get_state_number(),
    antlr4_parser:enter_recursion_rule(?<parser.name; format="upper">_RULE_<currentRule.name>, Precedence),
    <if(namedActions.init)>
    <namedActions.init>,
    <endif>
    try
        <code>
        <if(postamble)>,
        <postamble; separator=",\n        ">
        <endif>
    catch
        throw:Reason ->
            antlr4_parser:handle_rule_exception(Reason);
        error:Reason:Stacktrace ->
            antlr4_parser:handle_rule_exception({error, Reason, Stacktrace})
    <if(finallyAction)>
    after
        <finallyAction>
    <endif>
    end,
    antlr4_parser:unroll_recursion_contexts(_ParentCtx),
    antlr4_parser:get_state().
>>

CodeBlockForOuterMostAlt(currentOuterMostAltCodeBlock, locals, preamble, ops) ::= <<
<if(currentOuterMostAltCodeBlock.altLabel)>
antlr4_parser:set_alt_ctx(new_<currentOuterMostAltCodeBlock.altLabel; format="lower">_context()),
<endif>
antlr4_parser:enter_outer_alt(<currentOuterMostAltCodeBlock.alt.altNum>),
<CodeBlockForAlt(currentAltCodeBlock=currentOuterMostAltCodeBlock, ...)>
>>

CodeBlockForAlt(currentAltCodeBlock, locals, preamble, ops) ::= <<
<if(preamble)>
<preamble; separator=",\n">
<endif>
<if(ops)>
<ops; separator=",\n">
<endif>
>>

LL1AltBlock(choice, preamble, alts, error) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
<if(preamble)>
<preamble; separator=",\n">,
<endif>
case antlr4_parser:la(1) of
    <choice.altLook, alts:{look, alt | <look:{l | ?<parser.name; format="upper">_<l.name>}; separator=" ; "> ->
        <alt>}; separator=";\n    ">
    <if(error)>;
    _ ->
        <error>
    <endif>
end
>>

LL1OptionalBlock(choice, alts, error) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
case antlr4_parser:la(1) of
    <choice.altLook, alts:{look, alt | <look:{l | ?<parser.name; format="upper">_<l.name>}; separator=" ; "> ->
        <alt>}; separator=";\n    ">;
    _ ->
        ok
end
>>

LL1OptionalBlockSingleAlt(choice, expr, alts, preamble, error, followExpr) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
<if(preamble)>
<preamble; separator=",\n">,
<endif>
case <expr> of
    true ->
        <alts; separator=",\n        ">;
    false ->
        ok
end
>>

LL1StarBlockSingleAlt(choice, loopExpr, alts, preamble, iteration) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
<if(preamble)>
<preamble; separator=",\n">,
<endif>
star_loop_<choice.stateNumber>().

star_loop_<choice.stateNumber>() ->
    case <loopExpr> of
        true ->
            <alts; separator=",\n            ">,
            antlr4_parser:set_state(<choice.loopBackStateNumber>),
            antlr4_parser:sync(),
            <if(iteration)>
            <iteration>,
            <endif>
            star_loop_<choice.stateNumber>();
        false ->
            ok
    end
>>

LL1PlusBlockSingleAlt(choice, loopExpr, alts, preamble, iteration) ::= <<
antlr4_parser:set_state(<choice.blockStartStateNumber>),
antlr4_parser:sync(),
<if(preamble)>
<preamble; separator=",\n">,
<endif>
plus_loop_<choice.stateNumber>(true).

plus_loop_<choice.stateNumber>(true) ->
    <alts; separator=",\n    ">,
    antlr4_parser:set_state(<choice.stateNumber>),
    antlr4_parser:sync(),
    <if(iteration)>
    <iteration>,
    <endif>
    plus_loop_<choice.stateNumber>(<loopExpr>);
plus_loop_<choice.stateNumber>(false) ->
    ok
>>

AltBlock(choice, preamble, alts, error) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
<if(preamble)>
<preamble; separator=",\n">,
<endif>
case antlr4_parser:adaptive_predict(<choice.decision>) of
    <alts:{alt | <i> ->
        <alt>}; separator=";\n    ">
end
>>

OptionalBlock(choice, alts, error) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
<alts:{alt | case antlr4_parser:adaptive_predict(<choice.decision>) of
    <i><if(!choice.ast.greedy)> + 1<endif> ->
        <alt>
end}; separator=";\n">
>>

StarBlock(choice, alts, Sync, iteration) ::= <<
antlr4_parser:set_state(<choice.stateNumber>),
antlr4_parser:sync(),
star_block_<choice.stateNumber>(antlr4_parser:adaptive_predict(<choice.decision>)).

star_block_<choice.stateNumber>(Alt) when Alt =/= <choice.exitAlt>, Alt =/= ?ANTLR4_ATN_INVALID_ALT_NUMBER ->
    case Alt of
        1<if(!choice.ast.greedy)> + 1<endif> ->
            <if(iteration)>
            <iteration>,
            <endif>
            <alts>
    end,
    antlr4_parser:set_state(<choice.loopBackStateNumber>),
    antlr4_parser:sync(),
    star_block_<choice.stateNumber>(antlr4_parser:adaptive_predict(<choice.decision>));
star_block_<choice.stateNumber>(_Alt) ->
    ok
>>

PlusBlock(choice, alts, error) ::= <<
antlr4_parser:set_state(<choice.blockStartStateNumber>),
antlr4_parser:sync(),
plus_block_<choice.stateNumber>(1<if(!choice.ast.greedy)> + 1<endif>).

plus_block_<choice.stateNumber>(Alt) when Alt =/= <choice.exitAlt>, Alt =/= ?ANTLR4_ATN_INVALID_ALT_NUMBER ->
    case Alt of
        <alts:{alt | <i><if(!choice.ast.greedy)> + 1<endif> ->
            <alt>}; separator=";\n        ">
        <if(error)>;
        _ ->
            <error>
        <endif>
    end,
    antlr4_parser:set_state(<choice.loopBackStateNumber>),
    antlr4_parser:sync(),
    plus_block_<choice.stateNumber>(antlr4_parser:adaptive_predict(<choice.decision>));
plus_block_<choice.stateNumber>(_Alt) ->
    ok
>>

Sync(s) ::= "antlr4_parser:sync()"

ThrowNoViableAlt(t) ::= <<
throw({no_viable_alt, antlr4_parser:la(1)})
>>

TestSetInline(s) ::= <<
<s.bitsets:{bits | <if(rest(rest(bits.tokens)))><bitsetBitfieldComparison(s, bits)><else><bitsetInlineComparison(s, bits)><endif>}; separator=" orelse ">
>>

testShiftInRange(shiftAmount) ::= <<
((<shiftAmount>) band (bnot 16#3f)) =:= 0
>>

bitsetBitfieldComparison(s, bits) ::= <%
(<testShiftInRange({<offsetShiftVar(s.varName, bits.shift)>})> andalso (((1 bsl <offsetShiftVar(s.varName, bits.shift)>) band <bits.calculated>) =/= 0))
%>

isZero ::= [
"0":true,
default:false
]

offsetShiftVar(shiftAmount, offset) ::= <%
<if(!isZero.(offset))>(<shiftAmount> - <offset>)<else><shiftAmount><endif>
%>

offsetShiftType(shiftAmount, offset) ::= <%
<if(!isZero.(offset))>(?<parser.name; format="upper">_<shiftAmount> - <offset>)<else>?<parser.name; format="upper">_<shiftAmount><endif>
%>

bitsetInlineComparison(s, bits) ::= <%
<bits.tokens:{t | <s.varName> =:= ?<parser.name; format="upper">_<t.name>}; separator=" orelse ">
%>

InvokeRule(r, argExprsChunks) ::= <<
antlr4_parser:set_state(<r.stateNumber>),
<if(r.labels)>
<if(r.ast.options.p)>
<r.labels:{l | <l.escapedName>}; separator=", "> = '<r.escapedName>'(<r.ast.options.p><if(argExprsChunks)>, <argExprsChunks><endif>)
<else>
<r.labels:{l | <l.escapedName>}; separator=", "> = '<r.escapedName>'(<if(argExprsChunks)><argExprsChunks><endif>)
<endif>
<else>
<if(r.ast.options.p)>
'<r.escapedName>'(<r.ast.options.p><if(argExprsChunks)>, <argExprsChunks><endif>)
<else>
'<r.escapedName>'(<if(argExprsChunks)><argExprsChunks><endif>)
<endif>
<endif>
>>

MatchToken(m) ::= <<
antlr4_parser:set_state(<m.stateNumber>),
<if(m.labels)>
<m.labels:{l | <l.escapedName>}; separator=", "> = antlr4_parser:match(?<parser.name; format="upper">_<m.escapedName>)
<else>
antlr4_parser:match(?<parser.name; format="upper">_<m.escapedName>)
<endif>
>>

MatchSet(m, expr, capture) ::= "<CommonSetStuff(m, expr, capture, false)>"

MatchNotSet(m, expr, capture) ::= "<CommonSetStuff(m, expr, capture, true)>"

CommonSetStuff(m, expr, capture, invert) ::= <<
antlr4_parser:set_state(<m.stateNumber>),
<if(m.labels)>
<m.labels:{l | <l.escapedName>}; separator=", "> = antlr4_parser:lt(1),
<endif>
<if(capture)>
<capture>,
<endif>
<if(invert)>
case <m.varName> =\< 0 orelse <expr> of
<else>
case not (<expr>) of
<endif>
    true ->
        <if(m.labels)>
        <m.labels:{l | <l.escapedName>}; separator=", "> = antlr4_parser:recover_inline();
        <else>
        antlr4_parser:recover_inline();
        <endif>
    false ->
        antlr4_parser:report_match(),
        antlr4_parser:consume()
end
>>

Wildcard(w) ::= <<
antlr4_parser:set_state(<w.stateNumber>),
<if(w.labels)>
<w.labels:{l | <l.escapedName>}; separator=", "> = antlr4_parser:match_wildcard()
<else>
antlr4_parser:match_wildcard()
<endif>
>>

// ACTION STUFF

Action(a, foo, chunks) ::= "<chunks>"

ArgAction(a, chunks) ::= "<chunks>"

SemPred(p, chunks, failChunks) ::= <<
antlr4_parser:set_state(<p.stateNumber>),
case <chunks> of
    true -> ok;
    false ->
        throw({failed_predicate, <p.predicate><if(failChunks)>, <failChunks><elseif(p.msg)>, <p.msg><endif>})
end
>>

ExceptionClause(e, catchArg, catchAction) ::= <<
catch
    <catchArg> ->
        <catchAction>
>>

// lexer actions are not associated with model objects

LexerSkipCommand() ::= "antlr4_lexer:skip()"
LexerMoreCommand() ::= "antlr4_lexer:more()"
LexerPopModeCommand() ::= "antlr4_lexer:pop_mode()"
LexerTypeCommand(arg, grammar)     ::= "antlr4_lexer:set_type(<arg>)"
LexerChannelCommand(arg, grammar)  ::= "antlr4_lexer:set_channel(<arg>)"
LexerModeCommand(arg, grammar)     ::= "antlr4_lexer:set_mode(<arg>)"
LexerPushModeCommand(arg, grammar) ::= "antlr4_lexer:push_mode(<arg>)"

ActionText(t) ::= "<t.text>"
ActionTemplate(t) ::= "<t.st>"

ArgRef(a) ::= "antlr4_parser:get_attr(<a.escapedName>)"
LocalRef(a) ::= "<a.escapedName>"
RetValueRef(a) ::= "antlr4_parser:get_attr(<a.escapedName>)"
QRetValueRef(a) ::= "antlr4_parser:get_attr(<a.escapedName>)"

/** How to translate $tokenLabel */
TokenRef(t) ::= "antlr4_parser:get_token_ref(<t.escapedName>)"
LabelRef(t) ::= "antlr4_parser:get_label(<t.escapedName>)"
ListLabelRef(t) ::= "antlr4_parser:get_list_label(<t.escapedName>)"

SetAttr(s, rhsChunks) ::= "antlr4_parser:set_attr(<s.escapedName>, <rhsChunks>)"

TokenLabelType() ::= "<file.TokenLabelType; null={antlr4_token:token()}>"
InputSymbolType() ::= "<file.InputSymbolType; null={antlr4_token:token()}>"

TokenPropertyRef_text(t) ::= "antlr4_token:get_text(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_type(t) ::= "antlr4_token:get_type(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_line(t) ::= "antlr4_token:get_line(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_pos(t) ::= "antlr4_token:get_char_position_in_line(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_channel(t) ::= "antlr4_token:get_channel(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_index(t) ::= "antlr4_token:get_token_index(antlr4_parser:get_token_ref(<t.label>))"
TokenPropertyRef_int(t) ::= "binary_to_integer(antlr4_token:get_text(antlr4_parser:get_token_ref(<t.label>)))"

RulePropertyRef_start(r) ::= "antlr4_parser:get_rule_start(<r.label>)"
RulePropertyRef_stop(r) ::= "antlr4_parser:get_rule_stop(<r.label>)"
RulePropertyRef_text(r) ::= "antlr4_parser:get_rule_text(<r.label>)"
RulePropertyRef_ctx(r) ::= "antlr4_parser:get_rule_ctx(<r.label>)"
RulePropertyRef_parser(r) ::= "antlr4_parser:get_state()"

ThisRulePropertyRef_start(r) ::= "antlr4_parser:get_start()"
ThisRulePropertyRef_stop(r) ::= "antlr4_parser:get_stop()"
ThisRulePropertyRef_text(r) ::= "antlr4_parser:get_text()"
ThisRulePropertyRef_ctx(r) ::= "antlr4_parser:get_ctx()"
ThisRulePropertyRef_parser(r) ::= "antlr4_parser:get_state()"

NonLocalAttrRef(s) ::= "antlr4_parser:get_nonlocal_attr(<s.ruleIndex>, <s.escapedName>)"
SetNonLocalAttr(s, rhsChunks) ::= "antlr4_parser:set_nonlocal_attr(<s.ruleIndex>, <s.escapedName>, <rhsChunks>)"

AddToLabelList(a) ::= "antlr4_parser:add_to_label_list(<a.listName>, <labelref(a.label)>)"

TokenDecl(t) ::= "<t.escapedName> :: <ErlangTypeMap.(TokenLabelType())>"
TokenTypeDecl(t) ::= "<t.escapedName> :: integer()"
TokenListDecl(t) ::= "<t.escapedName> :: [<TokenLabelType()>]"

RuleContextDecl(r) ::= "<r.escapedName> :: term()"
RuleContextListDecl(rdecl) ::= "<rdecl.escapedName> :: [term()]"

AttributeDecl(d) ::= "<d.escapedName> :: <ErlangTypeMap.(d.type)><if(d.initValue)> % = <d.initValue><endif>"

ContextTokenGetterDecl(t) ::= ""
ContextTokenListGetterDecl(t) ::= ""
ContextTokenListIndexedGetterDecl(t) ::= ""
ContextRuleGetterDecl(r) ::= ""
ContextRuleListGetterDecl(r) ::= ""
ContextRuleListIndexedGetterDecl(r) ::= ""

LexerRuleContext() ::= "lexer_rule_context"

/** The rule context name is the rule followed by a suffix; e.g.,
 *  r becomes r_context.
 */
RuleContextNameSuffix() ::= "_context"

ImplicitTokenLabel(tokenName) ::= "_<tokenName>"
ImplicitRuleLabel(ruleName) ::= "_<ruleName>"
ImplicitSetLabel(id) ::= "_tset<id>"
ListLabelName(label) ::= "<label>"

CaptureNextToken(d) ::= "<d.varName> = antlr4_parser:lt(1)"
CaptureNextTokenType(d) ::= "<d.varName> = antlr4_parser:la(1)"

StructDecl(struct, ctorAttrs, attrs, getters, dispatchMethods, interfaces, extensionMembers, signatures) ::= ""

AltLabelStructDecl(struct, attrs, getters, dispatchMethods, tokenDecls, tokenTypeDecls, tokenListDecls, ruleContextDecls, ruleContextListDecls, attributeDecls) ::= ""

ListenerDispatchMethod(method) ::= ""

VisitorDispatchMethod(method) ::= ""

/** If we don't know location of label def x, use this template */
labelref(x) ::= "<x.escapedName>"

/** For any action chunk, what is correctly-typed context struct ptr? */
ctx(actionChunk) ::= "Ctx"

// used for left-recursive rules
recRuleAltPredicate(ruleName, opPrec) ::= "antlr4_parser:precpred(<opPrec>)"
recRuleSetReturnAction(src, name) ::= "ok"
recRuleSetStopToken() ::= "antlr4_parser:set_stop_token(antlr4_parser:lt(-1))"

recRuleAltStartAction(ruleName, ctxName, label, isListLabel) ::= <<
antlr4_parser:push_new_recursion_context(?<parser.name; format="upper">_RULE_<ruleName>)
>>

recRuleLabeledAltStartAction(ruleName, currentAltLabel, label, isListLabel) ::= <<
antlr4_parser:push_new_recursion_context(?<parser.name; format="upper">_RULE_<ruleName>)
>>

recRuleReplaceContext(ctxName) ::= <<
ok
>>

recRuleSetPrevCtx() ::= <<
antlr4_parser:trigger_exit_if_listeners()
>>

LexerFile(lexerFile, lexer, namedActions) ::= <<
<fileHeader(lexerFile.grammarFileName, lexerFile.ANTLRVersion)>

-module(<lexerFile.grammarName; format="lower">_lexer).

-export([
    new/1,
    next_token/1,
    get_all_tokens/1
]).

-include_lib("antlr4/include/antlr4_runtime.hrl").
<if(namedActions.header)>

<namedActions.header>
<endif>

<lexer>
>>

Lexer(lexer, atn, actionFuncs, sempredFuncs, superClass) ::= <<
%% Token type constants
-define(<lexer.name; format="upper">_EOF, -1).
<if(lexer.tokens)>
<lexer.tokens:{k | -define(<lexer.name; format="upper">_<k>, <lexer.tokens.(k)>).}; separator="\n">
<endif>

%% Channel constants
-define(<lexer.name; format="upper">_DEFAULT_TOKEN_CHANNEL, 0).
-define(<lexer.name; format="upper">_HIDDEN, 1).
<if(lexer.escapedChannels)>
<lexer.escapedChannels:{c | -define(<lexer.name; format="upper">_<c>, <lexer.escapedChannels.(c)>).}; separator="\n">
<endif>

%% Mode constants
-define(<lexer.name; format="upper">_DEFAULT_MODE, 0).
<if(rest(lexer.escapedModeNames))>
<rest(lexer.escapedModeNames):{m | -define(<lexer.name; format="upper">_<m>, <i>).}; separator="\n">
<endif>

%% Rule names
-define(RULE_NAMES, [<lexer.ruleNames:{r | "<r>"}; separator=", ">]).

%% Channel names
-define(CHANNEL_NAMES, ["DEFAULT_TOKEN_CHANNEL", "HIDDEN"<if(lexer.channelNames)>, <lexer.channelNames:{c | "<c>"}; separator=", "><endif>]).

%% Mode names
-define(MODE_NAMES, [<lexer.escapedModeNames:{m | "<m>"}; separator=", ">]).

%% Literal names
-define(LITERAL_NAMES, [<lexer.literalNames; null="undefined", separator=", ">]).

%% Symbolic names
-define(SYMBOLIC_NAMES, [<lexer.symbolicNames; null="undefined", separator=", ">]).

%% Serialized ATN
-define(SERIALIZED_ATN, <atn>).

%% Create a new lexer
new(Input) ->
    ATN = antlr4_atn_deserializer:deserialize(?SERIALIZED_ATN),
    DecisionToDFA = antlr4_atn:create_decision_to_dfa(ATN),
    SharedContextCache = antlr4_prediction_context:new_cache(),
    Interpreter = antlr4_lexer_atn_simulator:new(ATN, DecisionToDFA, SharedContextCache),
    #{
        input => Input,
        atn => ATN,
        interpreter => Interpreter,
        decision_to_dfa => DecisionToDFA,
        shared_context_cache => SharedContextCache,
        channel => ?<lexer.name; format="upper">_DEFAULT_TOKEN_CHANNEL,
        type => 0,
        mode => ?<lexer.name; format="upper">_DEFAULT_MODE,
        mode_stack => [],
        token_start_char_index => -1,
        token_start_line => 1,
        token_start_char_position_in_line => 0,
        text => undefined
    }.

%% Get next token
next_token(State) ->
    antlr4_lexer:next_token(State).

%% Get all tokens
get_all_tokens(State) ->
    get_all_tokens(State, []).

get_all_tokens(State, Acc) ->
    {Token, State1} = next_token(State),
    case antlr4_token:get_type(Token) of
        ?<lexer.name; format="upper">_EOF ->
            {lists:reverse([Token | Acc]), State1};
        _ ->
            get_all_tokens(State1, [Token | Acc])
    end.
<if(namedActions.members)>

<namedActions.members>
<endif>

<if(actionFuncs)>

action(LocalCtx, RuleIndex, ActionIndex, LexerState) ->
    case RuleIndex of
        <lexer.actionFuncs.values:{f | <f.ruleIndex> ->
            '<f.name>_action'(LocalCtx, ActionIndex, LexerState)}; separator=";\n        ">
    end.

<actionFuncs.values; separator="\n\n">
<endif>

<if(sempredFuncs)>

sempred(LocalCtx, RuleIndex, PredIndex, LexerState) ->
    case RuleIndex of
        <lexer.sempredFuncs.values:{f | <f.ruleIndex> ->
            '<f.name>_sempred'(LocalCtx, PredIndex, LexerState)}; separator=";\n        ">
    end.

<sempredFuncs.values; separator="\n\n">
<endif>
>>

RuleActionFunction(r, actions) ::= <<
'<r.escapedName>_action'(_LocalCtx, ActionIndex, LexerState) ->
    case ActionIndex of
        <actions:{index | <index> ->
            <actions.(index)>}; separator=";\n        ">;
        _ ->
            throw({no_registered_action, ActionIndex})
    end.
>>

RuleSempredFunction(r, actions) ::= <<
'<r.escapedName>_sempred'(_LocalCtx, PredIndex, _LexerState) ->
    case PredIndex of
        <actions:{index | <index> ->
            <actions.(index)>}; separator=";\n        ">;
        _ ->
            throw({no_predicate_with_index, PredIndex})
    end.
>>

SerializedATN(model) ::= <<
<if(model.serialized)>[
    <model.serialized; separator=", ", wrap>
]<endif>
>>

/** Using a type to init value map, try to init a type; if not in table
 *  must be an object, default value is "undefined".
 */
initValue(typeName) ::= <<
<erlangTypeInitMap.(typeName)>
>>

erlangTypeInitMap ::= [
    "integer":"0",
    "float":"0.0",
    "boolean":"false",
    default:"undefined"
]

codeFileExtension() ::= ".erl"
